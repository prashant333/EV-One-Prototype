# Map provider — optional. With nothing set, the prototype renders free
# OpenStreetMap tiles and needs no credentials.
#
# Copy to .env.local and fill in to upgrade the basemap:
#
#   VITE_MAP_PROVIDER=mapbox
#   VITE_MAPBOX_TOKEN=pk.eyJ1...
#
# Mapbox tokens: https://account.mapbox.com/access-tokens/ (free tier, no card)
#
# Google Maps is not a tile-layer swap — its terms require the Maps JavaScript
# API rather than direct tile access, so enabling it means adding the Google
# loader in src/components/MapView.tsx alongside a key.

VITE_MAP_PROVIDER=osm
